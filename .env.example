# AudioAgent local environment template.
# Spring Boot does not load this file automatically. Copy the values into your
# shell/IDE run configuration and never commit real passwords or API keys.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=audio_agent
DB_USER=root
DB_PASSWORD=replace-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=audioagent
RABBITMQ_PASS=replace-me

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=audioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET_NAME=audio-agent

FFMPEG_EXECUTABLE=D:/ffmpeg/bin/ffmpeg.exe
FFPROBE_EXECUTABLE=D:/ffmpeg/bin/ffprobe.exe
ASR_BASE_URL=http://127.0.0.1:8090
AUDIO_ANALYSIS_DISPATCH_MODE=rabbit

DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_MODEL_NAME=deepseek-v4-pro
