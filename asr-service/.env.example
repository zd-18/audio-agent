ASR_PROVIDER=funasr
ASR_MODEL=iic/SenseVoiceSmall
ASR_VAD_MODEL=fsmn-vad
# Recommended for sentence_info; leave empty to use timestamp/VAD fallback.
ASR_PUNC_MODEL=ct-punc
ASR_SPEAKER_MODEL=
ASR_DEVICE=cpu
ASR_BATCH_SIZE_SECONDS=20
ASR_DISABLE_UPDATE=true
ASR_TRANSCRIPTION_TIMEOUT_SECONDS=600
ASR_MAX_UPLOAD_BYTES=1073741824
# ASR_TEMP_DIR=D:/temp/audio-agent-asr
LOG_LEVEL=INFO
